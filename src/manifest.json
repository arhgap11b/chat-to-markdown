{
  "name": "chat-to-markdown",
  "version": "0.41",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "vendor/fflate.js",
        "chatgpt-export.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://*.web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "deep-research-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "content-gemini.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content-gemini.css"
      ]
    }
  ],
  "permissions": [
    "scripting",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://*.web-sandbox.oaiusercontent.com/*"
  ],
  "action": {
    "default_icon": "./assets/icon.png"
  }
}
